PORT=8787
ADMIN_API_KEY=change-me
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=86400

# Providers are configured as JSON. Never expose this value to browsers.
# Supported types: openai-compatible, anthropic, generic
PROVIDERS_JSON=[{"id":"cheap","type":"openai-compatible","baseUrl":"https://api.example.com/v1","apiKey":"replace-me","model":"cheap-model","inputCostPerMillion":0.2,"outputCostPerMillion":0.4},{"id":"premium","type":"anthropic","baseUrl":"https://api.anthropic.com/v1","apiKey":"replace-me","model":"premium-model","inputCostPerMillion":3,"outputCostPerMillion":15}]

# Ordered routing rules. The first matching rule wins.
ROUTES_JSON=[{"maxComplexity":3,"provider":"cheap"},{"maxComplexity":10,"provider":"premium"}]

# Production deployment additions
APP_ENV=production
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/promptcache
REDIS_URL=redis://HOST:6379/0
# Semantic embedding provider: fastembed (default, local ONNX), openai-compatible,
# deterministic (offline hash fallback, weaker matching), or none (exact cache only).
# All built-in providers emit 384-dim vectors to match the cache_records schema.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=replace-me
# Required only when EMBEDDING_PROVIDER=openai-compatible.
EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings

# Master key (Fernet, 32-byte urlsafe base64) used to encrypt API keys at rest.
# Generate with: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Rotating or losing this key makes previously stored keys unrecoverable.
API_KEY_ENC_MASTER_KEY=generate-a-fernet-key

# Redact emails/phones/card numbers/credential-like strings from prompts before
# they are persisted to the cache (matching keys still use the original text). 0 disables.
PII_REDACTION=1
# Emit one JSON object per log line (request logs become machine-parseable). Empty = plain text.
LOG_FORMAT=
# Usage-based pricing: percent of verified monthly savings charged as a platform fee.
SAVINGS_SHARE_PERCENT=10
# Optional monthly ceiling (USD) on the savings-based platform fee.
PLATFORM_FEE_CAP=


# Gateway rate limits
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
# How long (in days) to keep usage_events before pruning at startup; expired cache_records are always removed.
USAGE_RETENTION_DAYS=90
# Comma-separated dashboard origins allowed by CORS (empty = wildcard outside production)
CORS_ALLOW_ORIGINS=

# Stripe subscriptions (use test-mode keys while developing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTUP=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
DASHBOARD_URL=http://127.0.0.1:5173
